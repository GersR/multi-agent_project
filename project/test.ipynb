       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">updated_quote_response = quoting_agent(task=retry_quote_task, additional_args={\"stock_confirmation\": </span><span style=\"background-color: #0d1117\">              </span>\n",
