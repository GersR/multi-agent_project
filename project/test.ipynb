       "  <span style=\"color: #f8f8f2; text-decoration-color: #f8f8f2; background-color: #272822\">    </span><span style=\"color: #e6db74; text-decoration-color: #e6db74; background-color: #272822\">\"- 5,000 sheets of A3 paper, \"</span><span style=\"background-color: #272822\">                                                                             </span>  \n",
