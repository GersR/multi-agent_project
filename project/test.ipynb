       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">inventory_check_task = (</span><span style=\"background-color: #0d1117\">                                                                                           </span>\n",
       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">    \"Please check current stock levels for the following items to fulfill a customer order \"</span><span style=\"background-color: #0d1117\">                       </span>\n",
