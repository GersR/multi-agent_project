       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">retry_quote_task = (</span><span style=\"background-color: #0d1117\">                                                                                               </span>\n",
       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">    f\"Regenerate a price quote for order request dated {request_date} with delivery by {delivery_date}. \"</span><span style=\"background-color: #0d1117\">          </span>\n",
       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">    \"Stock levels have been confirmed sufficient for the following items:\\n\"</span><span style=\"background-color: #0d1117\">                                       </span>\n",
       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">    + \"\\n\".join([f\"- {item}: {qty}\" for item, qty in items_requested.items() if item != \"poster boards (24 x 36 </span><span style=\"background-color: #0d1117\">   </span>\n",
       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">inches)\"]) +</span><span style=\"background-color: #0d1117\">                                                                                                       </span>\n",
       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">    \"\\nExclude the poster boards (24 x 36 inches) from the quote due to external sourcing needs. \"</span><span style=\"background-color: #0d1117\">                 </span>\n",
