       "<span style=\"background-color: #0d1117\">                                                                                                                   </span>\n",
       "<span style=\"color: #e6edf3; text-decoration-color: #e6edf3; background-color: #0d1117\">inventory_response = inventory_agent(task=inventory_check_request, additional_args={})</span><span style=\"background-color: #0d1117\">                             </span>\n",
